    given-names: "Victor"
    affiliation: "LAPIG/UFG"
date-released: 2026-11-06
url: "https://victorgit10.github.io/denilson-ufg-chatbot/"
repository-code: "https://github.com/VictorGit10/denilson-ufg-chatbot"
license: CC-BY-4.0
keywords:
